<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="328*"/>
            <ColumnDefinition Width="97*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Редактор противников" FontSize="30" FontWeight="Bold" Margin="0,10,0,10" Grid.Row="0" HorizontalAlignment="Center" Width="338"/>
        <Button Content="Выбрать папку"
        Click="SelectFolderButton_Click"  Height="auto" Width="auto"   Grid.Row="7" Margin="30,10,10,10"/>
        <ListBox
Width="auto"
Height="auto"
Margin="55,40,55,40"
x:Name="IconsListBox"
SelectionChanged="IconsListBox_SelectionChanged" Grid.Column="0" Grid.RowSpan="5" Grid.Row="2"/>
        <TextBlock Text="Имя" FontSize="16" FontWeight="Bold" Margin="10,10,30,10" Grid.Row="1" Grid.Column="1"/>
        <TextBox x:Name="Name_enemy" Margin="10,40,30,10" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Text="Хп" FontSize="16" FontWeight="Bold" Margin="10,10,30,10" Grid.Row="2" Grid.Column="1"/>
        <TextBox x:Name="Health_enemy" Margin="10,40,30,10" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Text="Модификатор хп" FontSize="16" FontWeight="Bold" Margin="10,10,30,10" Grid.Row="3" Grid.Column="1"/>
        <TextBox x:Name="Health_mod_enemy" Margin="10,40,30,10" Grid.Row="3" Grid.Column="1"/>
        <TextBlock Text="Золото" FontSize="16" FontWeight="Bold" Margin="10,10,30,10" Grid.Row="4" Grid.Column="1"/>
        <TextBox x:Name="Gold_enemy" Margin="10,40,30,10" Grid.Row="4" Grid.Column="1"/>
        <TextBlock Text="Модификатор золота" FontSize="16" FontWeight="Bold" Margin="10,10,10,10" Grid.Row="5" Grid.Column="1"/>
        <TextBox x:Name="Gold_mod_enemy" Margin="10,40,30,10" Grid.Row="5" Grid.Column="1"/>
        <TextBlock Text="Спавн" FontSize="16" FontWeight="Bold" Margin="10,10,30,10" Grid.Row="6" Grid.Column="1"/>
        <TextBox x:Name="Spawn_enemy" Margin="10,40,30,10" Grid.Row="6" Grid.Column="1"/>
        <Button x:Name="Edit" Content="Редактировать" Click="Edit_Click"  Grid.Row="7" Grid.Column="1" Margin="10,5,30,51"/>
        <Button x:Name="Add" Content="Добавить" Click="Add_Click"  Grid.Row="7" Grid.Column="1" Margin="10,28,30,28"/>
        <Button x:Name="Delete" Content="Удалить" Click="Delete_Click"  Grid.Row="7" Grid.Column="1" Margin="10,51,30,5"/>


        <Button x:Name="Load" Content="Загрузить противника" Click="Load_Click"  Grid.Row="8" Grid.Column="0" Margin="0,34,454,31" HorizontalAlignment="Right" Width="154" />
        <Button x:Name="Save" Content="Сохранить" Click="Save_Click"  Grid.Row="8" Grid.Column="0" Margin="241,34,268,31"/>

    </Grid>
</Window>
