<Window x:Class="Lab_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="780" Width="880">
    <Window.Resources>
        <Style x:Key="EnemyComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#9B5E5F"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="FontFamily" Value="pack://application:,,,/Font/#bigdonstarve"/>
            <Setter Property="FontSize" Value="29"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="8,0,28,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"/>

                            <TextBlock x:Name="Placeholder" Text="Выберите тип противника"
                                   Margin="8,0,28,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>

                            <Path Data="M0,0 L5,5 L10,0" Stroke="Black" StrokeThickness="2"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0" IsHitTestVisible="False"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               Focusable="False" AllowsTransparency="True">
                                <Border Background="#9B5E5F" BorderBrush="Black" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, ElementName=Toggle}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="/Images/back1.png"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="346*"/>
            <ColumnDefinition Width="79*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Редактор противников" FontSize="50" FontWeight="Bold" Margin="187,0,0,6" Grid.Row="0" HorizontalAlignment="Left" Width="338" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <Button Content="Выбрать папку" FontFamily="pack://application:,,,/Font/#bigdonstarve"
        Click="SelectFolderButton_Click"  Height="auto" Width="auto" Margin="271,10,252,21" Grid.Row="1"  Background="Transparent" BorderBrush="Black" FontSize="35">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.813"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.386"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <ListBox
Width="auto"
Height="auto"
Margin="81,2,61,51"
x:Name="IconsListBox"
SelectionChanged="IconsListBox_SelectionChanged" Grid.Column="0" Grid.RowSpan="5" Grid.Row="3" Background="Black" BorderBrush="Transparent"/>
        <TextBlock Text="Имя" FontSize="30"   Margin="10,10,30,10" Grid.Row="1" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Name_enemy" Margin="10,40,30,0" Grid.Row="1" Grid.Column="1" Background="Transparent" BorderBrush="Black" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBlock Text="Здоровье" FontSize="30"   Margin="10,10,30,10" Grid.Row="2" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Health_enemy" Margin="10,40,30,72" Grid.Row="2" Grid.Column="1" Background="Transparent" BorderBrush="Black" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve" Grid.RowSpan="2"/>
        <TextBlock Text="Модификатор хп" FontSize="28"   Margin="10,10,10,10" Grid.Row="3" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Health_mod_enemy" Margin="10,40,30,71" Grid.Row="3" Grid.Column="1" Background="Transparent" BorderBrush="Black" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve" Grid.RowSpan="2"/>
        <TextBlock Text="Золото" FontSize="30"   Margin="10,10,30,10" Grid.Row="4" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Gold_enemy" Margin="10,40,30,0" Grid.Row="4" Grid.Column="1" Background="Transparent" BorderBrush="Black" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBlock Text="Модификатор золота" FontSize="24"   Margin="10,1,12,19" Grid.Row="5" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Gold_mod_enemy" Margin="10,40,30,71" Grid.Row="5" Grid.Column="1" Background="Transparent" BorderBrush="Black" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve" Grid.RowSpan="2"/>
        <TextBlock Text="Спавн" FontSize="25"   Margin="10,0,30,27" Grid.Row="6" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Spawn_enemy" Margin="10,30,30,10" Grid.Row="6" Grid.Column="1" Background="Transparent" BorderBrush="Black" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>

        <TextBlock Text="Особенности" FontSize="25" Foreground ="#9B5E5F"  Margin="10,0,30,27" Grid.Row="7" Grid.Column="1" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <TextBox x:Name="Special_enemy" Margin="10,30,30,10" Grid.Row="7" Foreground ="#9B5E5F" Grid.Column="1" Background="Transparent" BorderBrush="#9B5E5F" FontSize="25" FontFamily="pack://application:,,,/Font/#bigdonstarve"/>


        <Button x:Name="Edit" Content="Редактировать" Click="Edit_Click"  Grid.Row="8" Grid.Column="1"  Background="#9B5E5F" FontSize="20" BorderBrush="Black" FontFamily="pack://application:,,,/Font/#bigdonstarve" Margin="11,25,9,25"  />
        <Button x:Name="Add" Content="Добавить" Click="Add_Click"  Grid.Row="7" Grid.Column="1"   Background="#9B5E5F" FontSize="20" BorderBrush="Black" FontFamily="pack://application:,,,/Font/#bigdonstarve" Margin="11,72,9,47" Grid.RowSpan="2"/>
        <Button x:Name="Delete" Content="Удалить" Click="Delete_Click"  Grid.Row="8" Grid.Column="1"   Background="#9B5E5F"  FontSize="20" BorderBrush="Black"  FontFamily="pack://application:,,,/Font/#bigdonstarve" Margin="11,47,9,2"    />

        <ComboBox x:Name="TypeEnemies" Style="{StaticResource EnemyComboBox}"
          Grid.Row="8" Grid.Column="0" Margin="456,6,0,29"> 
            <ComboBoxItem>Обычный противник</ComboBoxItem>
            <ComboBoxItem>Бронированный противник</ComboBoxItem>
            <ComboBoxItem>Алчный гоблин</ComboBoxItem>
        </ComboBox>

        <Button x:Name="Load" Content="Загрузить противника" Click="Load_Click"  Grid.Row="8" Grid.Column="0" Margin="28,6,493,29" Background="#9B5E5F" FontSize="23" BorderBrush="Black"  FontFamily="pack://application:,,,/Font/#bigdonstarve"/>
        <Button x:Name="Save" Content="Сохранить" Click="Save_Click"  Grid.Row="8" Grid.Column="0" Margin="241,6,268,29" Background="#9B5E5F" FontSize="30" BorderBrush="Black" FontFamily="pack://application:,,,/Font/#bigdonstarve" RenderTransformOrigin="0.5,0.5">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.626"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.189"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>

        <ListBox x:Name="EnemiesListBox" Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
          SelectionChanged="EnemiesListBox_SelectionChanged"
         Background="#9B5E5F" BorderBrush="#9B5E5F" FontSize="18"
         FontFamily="pack://application:,,,/Font/#bigdonstarve" Margin="25,0,25,25"/>

    </Grid>
</Window>
